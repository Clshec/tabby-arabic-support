{
  "name": "tabby-arabic-support",
  "version": "1.0.0",
  "description": "Comprehensive Arabic, Persian, Urdu & RTL language support plugin for Tabby Terminal with real-time contextual font shaping and BiDi layout",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "keywords": [
    "tabby-plugin",
    "arabic",
    "arabic-support",
    "rtl",
    "bidi",
    "arabic-shaping",
    "hebrew",
    "persian",
    "urdu"
  ],
  "scripts": {
    "build": "webpack --mode production --color",
    "watch": "webpack --mode development --watch --color",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "author": "Abdulrahman Saad Hashem",
  "license": "MIT",
  "dependencies": {
    "bidi-js": "^1.0.3"
  },
  "devDependencies": {
    "@angular/common": "^15.0.0",
    "@angular/core": "^15.0.0",
    "@angular/forms": "^15.0.0",
    "@types/node": "^20.0.0",
    "rxjs": "^7.8.0",
    "tabby-core": "1.0.197-nightly.1",
    "tabby-settings": "1.0.197-nightly.1",
    "tabby-terminal": "1.0.197-nightly.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  }
}
